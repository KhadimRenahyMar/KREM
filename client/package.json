{
  "name": "krem-front",
  "proxy": "http://localhost:3000",
  "scripts": {
    "dev:start": "concurrently --kill-others \"npx tailwindcss -i ./src/styles/index.css -o ./src/styles/output.css --watch\" \"cross-env NODE_ENV=development vite --mode development\"",
    "dev:build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "lint:fix": "eslint --fix ./src/** --no-error-on-unmatched-pattern",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist node_modules yarn.lock package-lock.json"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
